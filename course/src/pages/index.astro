---
import CourseLayout from "../layouts/CourseLayout.astro";
import { course } from "../../contracts/lessons";

const base = import.meta.env.BASE_URL;
const descriptors = [
  { number: "01", label: "Contrato", object: "Bono", detail: "Quién paga, cuánto y cuándo" },
  { number: "02", label: "Valoración", object: "Σ PV", detail: "Cash flows → precio" },
  { number: "03", label: "Rendimiento", object: "YTM", detail: "Convención vs retorno realizado" },
  { number: "04", label: "Mercado", object: "Curva", detail: "Bonos → puntos → estructura" }
];
---

<CourseLayout title="Fixed Income Foundations" description="Cuatro lecciones interactivas: del contrato del bono a la curva de tipos" pageClass="landing-page">
  <main class="landing shell">
    <header class="landing-nav">
      <a class="wordmark" href={base}><span>B–04</span><b>Fixed Income · Block 01</b></a>
      <div><span class="pill">4 lecciones</span><span class="pill">40 min / sesión</span><a class="pill" href={`${base}checkpoint/`}>Checkpoint</a></div>
    </header>

    <section class="landing-hero">
      <div class="landing-copy">
        <span class="eyebrow">Interactive learning runtime · V1</span>
        <h1 class="display">Fundamentos<br />de los <em>bonos</em></h1>
        <p>Qué compras, cómo se convierte en cash flows, cómo se valora y cómo el mercado lo organiza en una curva.</p>
        <div class="landing-actions"><a class="button" href={`${base}lessons/${course.lessons[0]?.slug}/?mode=aula`}>Empezar en aula <span>→</span></a><a class="button secondary" href={`${base}lessons/${course.lessons[0]?.slug}/?mode=estudio`}>Estudiar a mi ritmo</a></div>
      </div>
      <div class="landing-object" aria-label="El bono B-04 se transforma en cash flows y en una curva">
        <div class="hero-bond"><span>B–04</span><small>ESTADO / EMPRESA</small><strong>BONO 5 AÑOS</strong><dl><div><dt>Cupón</dt><dd>4%</dd></div><div><dt>Notional</dt><dd>100 €</dd></div><div><dt>FV</dt><dd>100 €</dd></div></dl></div>
        <svg viewBox="0 0 720 260" role="img" aria-labelledby="spine-title spine-desc">
          <title id="spine-title">Contract Spine</title><desc id="spine-desc">El bono produce cinco pagos y después se convierte en un punto de la curva.</desc>
          <path class="spine" d="M45 92 H 470 C 540 92 545 195 615 195 H690" />
          {[45,145,245,345,445].map((x, index) => <g><circle cx={x} cy="92" r={index === 4 ? 17 : 12} /><text x={x} y="62" text-anchor="middle">{index === 4 ? "104" : "4"}</text><text x={x} y="128" text-anchor="middle">{index + 1}Y</text></g>)}
          <g class="curve-mini"><path d="M510 222 C555 190 590 152 625 155 S675 128 700 135" /><circle cx="555" cy="190" r="5"/><circle cx="625" cy="155" r="5"/><circle cx="700" cy="135" r="5"/></g>
        </svg>
        <p><span>Contrato</span><i>→</i><span>Cash flows</span><i>→</i><span>Precio / YTM</span><i>→</i><span>Curva</span></p>
      </div>
    </section>

    <section class="course-map" aria-labelledby="map-title">
      <div class="map-heading"><span class="eyebrow">Mapa del bloque</span><h2 id="map-title">Un único objeto. Cuatro formas de entenderlo.</h2></div>
      <ol>
        {course.lessons.map((lesson, index) => <li>
          <a href={`${base}lessons/${lesson.slug}/?mode=estudio`}>
            <div class="station"><span>{descriptors[index]?.number}</span><b>{descriptors[index]?.object}</b></div>
            <small>{descriptors[index]?.label}</small>
            <h3>{lesson.title}</h3>
            <p>{descriptors[index]?.detail}</p>
            <footer><span>20 min LIVE</span><span>20 min LAB</span><i>↗</i></footer>
          </a>
        </li>)}
      </ol>
    </section>

    <section class="landing-checkpoint">
      <div><span class="eyebrow">Cierre acumulativo</span><h2>Un bono. Siete decisiones.</h2><p>5Y · cupón 3% · face value 100 · precio 95,55. Construye sus flujos, descuéntalos, infiere su YTM y colócalo en la curva.</p></div>
      <a class="button" href={`${base}checkpoint/`}>Abrir checkpoint <span>→</span></a>
    </section>
  </main>
</CourseLayout>
