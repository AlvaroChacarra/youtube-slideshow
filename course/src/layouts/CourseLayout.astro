---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  pageClass?: string;
}

const { title, description = "Interactive fixed-income foundations", pageClass = "" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#021322" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <slot />
  </body>
</html>
