{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlvaroChacarra/youtube-slideshow/contracts/visual-contract.schema.json",
  "x-schema-version": "2.1.0",
  "title": "Visual Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "project_id",
    "narrative_hash",
    "status",
    "direction_id",
    "direction_options",
    "user_approval",
    "global_system",
    "anti_defaults",
    "scenes",
    "mobile",
    "prohibited_patterns",
    "known_limitations"
  ],
  "properties": {
    "contract_version": { "$ref": "#/$defs/version" },
    "workflow_mode": { "enum": ["concept_first", "approved_reference"] },
    "project_id": { "$ref": "#/$defs/nonEmpty" },
    "narrative_hash": {
      "$ref": "#/$defs/sha256",
      "description": "Hash del artefacto narrativo canónico consumido; los hashes de specs de unidad permanecen separados."
    },
    "status": {
      "enum": ["draft", "pending_user_approval", "approved", "rejected", "superseded"]
    },
    "direction_id": {
      "$ref": "#/$defs/nonEmpty",
      "description": "En approved_reference identifica establemente la dirección formalizada desde el bundle, no una alternativa generada."
    },
    "direction_options": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/directionOption" }
    },
    "reference_bundle": { "$ref": "#/$defs/referenceBundle" },
    "reference_bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/referenceBinding" }
    },
    "user_approval": { "$ref": "#/$defs/userApproval" },
    "global_system": { "$ref": "#/$defs/globalSystem" },
    "anti_defaults": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    },
    "mobile": { "$ref": "#/$defs/mobile" },
    "prohibited_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "known_limitations": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmpty" }
    }
  },
  "dependentSchemas": {
    "reference_bundle": {
      "required": ["workflow_mode", "reference_bindings"],
      "properties": { "workflow_mode": { "const": "approved_reference" } }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "workflow_mode": { "const": "approved_reference" } },
        "required": ["workflow_mode"]
      },
      "then": {
        "required": ["reference_bundle", "reference_bindings"],
        "properties": {
          "contract_version": { "const": "2.1.0" },
          "direction_options": { "maxItems": 0 },
          "reference_bindings": { "minItems": 1 }
        }
      },
      "else": {
        "properties": {
          "direction_options": { "minItems": 3, "maxItems": 3 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
      "then": {
        "properties": {
          "user_approval": {
            "properties": {
              "status": { "const": "approved" },
              "reviewer": { "$ref": "#/$defs/nonEmpty" },
              "reviewed_at": { "type": "string", "format": "date-time" },
              "approval_reference": { "$ref": "#/$defs/nonEmpty" },
              "changes_resolved": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
          {
            "not": {
              "properties": { "workflow_mode": { "const": "approved_reference" } },
              "required": ["workflow_mode"]
            }
          }
        ]
      },
      "then": {
        "properties": {
          "user_approval": {
            "properties": {
              "selected_direction_id": { "$ref": "#/$defs/nonEmpty" },
              "rejected_direction_ids": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/nonEmpty" }
              },
              "selection_reason": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          { "properties": { "workflow_mode": { "const": "approved_reference" } }, "required": ["workflow_mode"] },
          { "properties": { "status": { "const": "approved" } }, "required": ["status"] }
        ]
      },
      "then": {
        "properties": {
          "reference_bundle": {
            "properties": {
              "units": {
                "items": {
                  "properties": { "approval_reference": { "$ref": "#/$defs/nonEmpty" } }
                }
              }
            }
          },
          "user_approval": {
            "required": ["approval_source", "source_branch", "source_commit", "semantic_spec", "reference"],
            "properties": {
              "approval_source": { "const": "approved_reference" },
              "source_branch": { "$ref": "#/$defs/nonEmpty" },
              "source_commit": { "$ref": "#/$defs/gitSha" },
              "semantic_spec": { "$ref": "#/$defs/artifactPointer" },
              "reference": { "$ref": "#/$defs/artifactPointer" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "pending_user_approval" } }, "required": ["status"] },
      "then": {
        "properties": {
          "user_approval": { "properties": { "status": { "const": "pending" } } }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "rejected" } }, "required": ["status"] },
      "then": {
        "properties": {
          "user_approval": { "properties": { "status": { "const": "rejected" } } }
        }
      }
    }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "directionOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction_id",
        "thesis",
        "macro_composition",
        "representation",
        "spatial_relationship",
        "protagonist_behavior",
        "transformation_grammar",
        "density",
        "text_use",
        "mobile_approach",
        "primary_risk"
      ],
      "properties": {
        "direction_id": { "$ref": "#/$defs/nonEmpty" },
        "thesis": { "$ref": "#/$defs/nonEmpty" },
        "macro_composition": { "$ref": "#/$defs/nonEmpty" },
        "representation": { "$ref": "#/$defs/nonEmpty" },
        "spatial_relationship": { "$ref": "#/$defs/nonEmpty" },
        "protagonist_behavior": { "$ref": "#/$defs/nonEmpty" },
        "transformation_grammar": { "$ref": "#/$defs/nonEmpty" },
        "density": { "$ref": "#/$defs/nonEmpty" },
        "text_use": { "$ref": "#/$defs/nonEmpty" },
        "mobile_approach": { "$ref": "#/$defs/nonEmpty" },
        "primary_risk": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "userApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checkpoint_id",
        "reviewer",
        "reviewed_at",
        "approval_reference",
        "selected_direction_id",
        "rejected_direction_ids",
        "selection_reason",
        "requested_changes",
        "changes_resolved"
      ],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected"] },
        "checkpoint_id": { "$ref": "#/$defs/nonEmpty" },
        "reviewer": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "approval_reference": { "type": ["string", "null"] },
        "selected_direction_id": { "type": ["string", "null"] },
        "rejected_direction_ids": { "$ref": "#/$defs/stringList" },
        "selection_reason": { "type": ["string", "null"] },
        "requested_changes": { "$ref": "#/$defs/stringList" },
        "changes_resolved": { "type": "boolean" },
        "approval_source": { "enum": ["human_checkpoint", "approved_reference", null] },
        "source_branch": { "type": ["string", "null"] },
        "source_commit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$" },
        "semantic_spec": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["path", "content_hash"],
          "properties": {
            "path": { "$ref": "#/$defs/nonEmpty" },
            "content_hash": { "$ref": "#/$defs/sha256" }
          }
        },
        "reference": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["path", "content_hash"],
          "properties": {
            "path": { "$ref": "#/$defs/nonEmpty" },
            "content_hash": { "$ref": "#/$defs/sha256" }
          }
        },
        "supplemental_approvals": {
          "type": "array",
          "items": { "$ref": "#/$defs/approvalRecord" }
        }
      }
    },
    "approvalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "reviewer", "reviewed_at", "approval_reference"],
      "properties": {
        "scope": { "$ref": "#/$defs/nonEmpty" },
        "reviewer": { "$ref": "#/$defs/nonEmpty" },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "approval_reference": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "artifactPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_hash"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "perceptualReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "path", "content_hash", "media_type"],
      "properties": {
        "reference_id": {
          "$ref": "#/$defs/nonEmpty",
          "description": "Identificador perceptual estable que resuelven los reference_bindings."
        },
        "path": { "$ref": "#/$defs/nonEmpty" },
        "content_hash": { "$ref": "#/$defs/sha256" },
        "media_type": { "type": "string", "pattern": "^image/[a-z0-9.+-]+$" }
      }
    },
    "elementClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "role", "render_mode", "rationale", "source_provenance"],
      "properties": {
        "element_id": { "$ref": "#/$defs/nonEmpty" },
        "role": { "$ref": "#/$defs/nonEmpty" },
        "render_mode": { "enum": ["code_native", "asset"] },
        "rationale": { "$ref": "#/$defs/nonEmpty" },
        "source_provenance": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "render_mode": { "const": "asset" } }, "required": ["render_mode"] },
          "then": { "properties": { "source_provenance": { "$ref": "#/$defs/nonEmpty" } } }
        }
      ]
    },
    "referenceUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "semantic_spec",
        "perceptual_reference",
        "approval_reference",
        "reference_role",
        "element_classification"
      ],
      "properties": {
        "unit_id": {
          "$ref": "#/$defs/nonEmpty",
          "description": "Identificador de la unidad semántica; puede conservarse al aportar más de una referencia perceptual."
        },
        "semantic_spec": { "$ref": "#/$defs/artifactPointer" },
        "perceptual_reference": { "$ref": "#/$defs/perceptualReference" },
        "approval_reference": { "type": ["string", "null"] },
        "reference_role": { "enum": ["key_hold", "initial_hold", "final_hold", "multi_hold"] },
        "element_classification": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/elementClassification" }
        }
      }
    },
    "referenceBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_branch", "source_commit", "design", "project", "authority_resolution", "units"],
      "properties": {
        "source_branch": { "$ref": "#/$defs/nonEmpty" },
        "source_commit": { "$ref": "#/$defs/gitSha" },
        "design": { "$ref": "#/$defs/artifactPointer" },
        "project": { "$ref": "#/$defs/artifactPointer" },
        "authority_resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantic_authority", "perceptual_authority", "conflict_policy"],
          "properties": {
            "semantic_authority": { "const": "semantic_spec" },
            "perceptual_authority": { "const": "approved_reference" },
            "conflict_policy": { "const": "block_upstream" }
          }
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/referenceUnit" }
        }
      }
    },
    "referenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "scene_id",
        "hold_ids",
        "required_perceptual_properties",
        "mutable_properties",
        "conceptual_tolerances",
        "uncovered_parts"
      ],
      "properties": {
        "reference_id": {
          "$ref": "#/$defs/nonEmpty",
          "description": "Resuelve perceptual_reference.reference_id dentro del bundle."
        },
        "scene_id": { "$ref": "#/$defs/nonEmpty" },
        "hold_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "required_perceptual_properties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "mutable_properties": { "$ref": "#/$defs/stringList" },
        "conceptual_tolerances": { "$ref": "#/$defs/stringList" },
        "uncovered_parts": { "$ref": "#/$defs/stringList" }
      }
    },
    "globalSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_thesis",
        "domain_signature",
        "representation_principles",
        "composition_grammar",
        "hierarchy",
        "density",
        "text_role",
        "color_roles",
        "typography_roles"
      ],
      "properties": {
        "concept_thesis": { "$ref": "#/$defs/nonEmpty" },
        "domain_signature": { "$ref": "#/$defs/nonEmpty" },
        "representation_principles": { "$ref": "#/$defs/stringList" },
        "composition_grammar": { "$ref": "#/$defs/nonEmpty" },
        "hierarchy": { "$ref": "#/$defs/nonEmpty" },
        "density": { "$ref": "#/$defs/nonEmpty" },
        "text_role": { "$ref": "#/$defs/nonEmpty" },
        "color_roles": { "$ref": "#/$defs/stringList" },
        "typography_roles": { "$ref": "#/$defs/stringList" }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "goal",
        "takeaway",
        "protagonist",
        "invariants",
        "representation",
        "holds",
        "reading_path",
        "spatial_ownership",
        "text_budget",
        "mobile_behavior",
        "exclusions"
      ],
      "properties": {
        "scene_id": { "$ref": "#/$defs/nonEmpty" },
        "goal": { "$ref": "#/$defs/nonEmpty" },
        "takeaway": { "$ref": "#/$defs/nonEmpty" },
        "protagonist": { "$ref": "#/$defs/protagonist" },
        "invariants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
        "representation": { "$ref": "#/$defs/representation" },
        "holds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hold" } },
        "reading_path": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
        "spatial_ownership": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/spatialOwner" } },
        "text_budget": { "$ref": "#/$defs/textBudget" },
        "mobile_behavior": { "$ref": "#/$defs/sceneMobile" },
        "exclusions": { "$ref": "#/$defs/stringList" }
      }
    },
    "protagonist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "support", "context", "absent"],
      "properties": {
        "primary": { "$ref": "#/$defs/nonEmpty" },
        "support": { "$ref": "#/$defs/stringList" },
        "context": { "$ref": "#/$defs/stringList" },
        "absent": { "$ref": "#/$defs/stringList" }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_object", "mechanism", "encodings", "why_visual"],
      "properties": {
        "domain_object": { "$ref": "#/$defs/nonEmpty" },
        "mechanism": { "$ref": "#/$defs/nonEmpty" },
        "encodings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
        "why_visual": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "hold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hold_id",
        "purpose",
        "description",
        "dominant_element",
        "static_success_criteria",
        "absent_elements"
      ],
      "properties": {
        "hold_id": { "$ref": "#/$defs/nonEmpty" },
        "purpose": { "$ref": "#/$defs/nonEmpty" },
        "description": { "$ref": "#/$defs/nonEmpty" },
        "dominant_element": { "$ref": "#/$defs/nonEmpty" },
        "static_success_criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
        "absent_elements": { "$ref": "#/$defs/stringList" }
      }
    },
    "spatialOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "owner", "boundary_rule"],
      "properties": {
        "region": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "boundary_rule": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "textBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_visible_words", "max_simultaneous_labels", "essential_text"],
      "properties": {
        "max_visible_words": { "type": "integer", "minimum": 0 },
        "max_simultaneous_labels": { "type": "integer", "minimum": 0 },
        "essential_text": { "$ref": "#/$defs/stringList" }
      }
    },
    "sceneMobile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserved_takeaway", "composition_change", "reading_path", "label_policy"],
      "properties": {
        "preserved_takeaway": { "$ref": "#/$defs/nonEmpty" },
        "composition_change": { "$ref": "#/$defs/nonEmpty" },
        "reading_path": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
        "label_policy": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "mobile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_widths_px", "downsample_width_px", "minimum_text_px", "sibling_composition_rule"],
      "properties": {
        "target_widths_px": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 240 } },
        "downsample_width_px": { "type": "integer", "minimum": 240 },
        "minimum_text_px": { "type": "number", "exclusiveMinimum": 0 },
        "sibling_composition_rule": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  }
}
