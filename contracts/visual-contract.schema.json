{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlvaroChacarra/youtube-slideshow/contracts/visual-contract.schema.json",
  "x-schema-version": "3.0.0",
  "title": "Visual Contract V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "workflow_mode",
    "project_id",
    "narrative_hash",
    "status",
    "direction_id",
    "direction_options",
    "user_approval",
    "global_system",
    "scenes",
    "prohibited_patterns",
    "known_limitations"
  ],
  "properties": {
    "contract_version": { "const": "3.0.0" },
    "workflow_mode": {
      "enum": ["concept_first", "approved_reference", "reference_guided_enhancement"]
    },
    "project_id": { "$ref": "#/$defs/nonEmpty" },
    "narrative_hash": { "$ref": "#/$defs/sha256" },
    "status": {
      "enum": ["draft", "pending_user_approval", "approved", "rejected", "superseded"]
    },
    "direction_id": { "$ref": "#/$defs/nonEmpty" },
    "direction_options": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/directionOption" }
    },
    "user_approval": { "$ref": "#/$defs/userApproval" },
    "reference_bundle": { "$ref": "#/$defs/referenceBundle" },
    "reference_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/referenceBinding" }
    },
    "enhancement_intent": { "$ref": "#/$defs/enhancementIntent" },
    "transformative_delta": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/transformativeDelta" }
    },
    "aesthetic_system": { "$ref": "#/$defs/aestheticSystem" },
    "attention_model": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attentionStep" }
    },
    "geometry_constraints": { "$ref": "#/$defs/geometryConstraints" },
    "comparison_plan": { "$ref": "#/$defs/comparisonPlan" },
    "global_system": { "$ref": "#/$defs/globalSystem" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    },
    "prohibited_patterns": { "$ref": "#/$defs/nonEmptyList" },
    "known_limitations": { "$ref": "#/$defs/stringList" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "workflow_mode": { "const": "concept_first" } },
        "required": ["workflow_mode"]
      },
      "then": {
        "properties": { "direction_options": { "minItems": 3, "maxItems": 3 } }
      },
      "else": {
        "required": ["reference_bundle", "reference_bindings"],
        "properties": { "direction_options": { "maxItems": 0 } }
      }
    },
    {
      "if": {
        "properties": { "workflow_mode": { "const": "reference_guided_enhancement" } },
        "required": ["workflow_mode"]
      },
      "then": {
        "required": [
          "enhancement_intent",
          "transformative_delta",
          "aesthetic_system",
          "attention_model",
          "geometry_constraints",
          "comparison_plan"
        ],
        "properties": {
          "reference_bundle": {
            "properties": {
              "authority_resolution": {
                "properties": {
                  "perceptual_authority": { "const": "reference_guided_enhancement" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "approved" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "user_approval": {
            "properties": {
              "status": { "const": "approved" },
              "changes_resolved": { "const": true }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "nonEmptyList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "artifactPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_hash"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "directionOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction_id", "thesis", "macro_composition", "primary_risk"],
      "properties": {
        "direction_id": { "$ref": "#/$defs/nonEmpty" },
        "thesis": { "$ref": "#/$defs/nonEmpty" },
        "macro_composition": { "$ref": "#/$defs/nonEmpty" },
        "primary_risk": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "userApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checkpoint_id",
        "reviewer",
        "reviewed_at",
        "approval_reference",
        "approval_scope",
        "changes_resolved"
      ],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected"] },
        "checkpoint_id": { "$ref": "#/$defs/nonEmpty" },
        "reviewer": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"] },
        "approval_reference": { "type": ["string", "null"] },
        "approval_scope": { "$ref": "#/$defs/nonEmpty" },
        "changes_resolved": { "type": "boolean" }
      }
    },
    "referenceUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "semantic_spec",
        "reference_id",
        "reference",
        "approval_reference",
        "element_classification"
      ],
      "properties": {
        "unit_id": { "$ref": "#/$defs/nonEmpty" },
        "semantic_spec": { "$ref": "#/$defs/artifactPointer" },
        "reference_id": { "$ref": "#/$defs/nonEmpty" },
        "reference": { "$ref": "#/$defs/artifactPointer" },
        "approval_reference": { "$ref": "#/$defs/nonEmpty" },
        "element_classification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["element_id", "render_mode", "rationale"],
            "properties": {
              "element_id": { "$ref": "#/$defs/nonEmpty" },
              "render_mode": { "enum": ["code_native", "asset"] },
              "rationale": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        }
      }
    },
    "referenceBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_branch",
        "source_commit",
        "design",
        "project",
        "authority_resolution",
        "units"
      ],
      "properties": {
        "source_branch": { "$ref": "#/$defs/nonEmpty" },
        "source_commit": { "$ref": "#/$defs/gitSha" },
        "design": { "$ref": "#/$defs/artifactPointer" },
        "project": { "$ref": "#/$defs/artifactPointer" },
        "authority_resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantic_authority", "perceptual_authority", "conflict_policy"],
          "properties": {
            "semantic_authority": { "const": "semantic_spec" },
            "perceptual_authority": {
              "enum": ["approved_reference", "reference_guided_enhancement"]
            },
            "conflict_policy": { "const": "block_upstream" }
          }
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/referenceUnit" }
        }
      }
    },
    "referenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "scene_id",
        "baseline_hold_id",
        "enhanced_hold_ids",
        "essential_invariants",
        "mutable_properties",
        "uncovered_parts"
      ],
      "properties": {
        "reference_id": { "$ref": "#/$defs/nonEmpty" },
        "scene_id": { "$ref": "#/$defs/nonEmpty" },
        "baseline_hold_id": { "$ref": "#/$defs/nonEmpty" },
        "enhanced_hold_ids": { "$ref": "#/$defs/nonEmptyList" },
        "essential_invariants": { "$ref": "#/$defs/nonEmptyList" },
        "mutable_properties": { "$ref": "#/$defs/stringList" },
        "uncovered_parts": { "$ref": "#/$defs/stringList" }
      }
    },
    "enhancementIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "dimensions", "success_signals"],
      "properties": {
        "summary": { "$ref": "#/$defs/nonEmpty" },
        "dimensions": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["visual", "pedagogical", "immersive", "spatial"]
          }
        },
        "success_signals": { "$ref": "#/$defs/nonEmptyList" }
      }
    },
    "transformativeDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delta_id",
        "scene_id",
        "property",
        "baseline",
        "enhanced",
        "reason",
        "expected_evidence",
        "essence_preserved"
      ],
      "properties": {
        "delta_id": { "$ref": "#/$defs/nonEmpty" },
        "scene_id": { "$ref": "#/$defs/nonEmpty" },
        "property": { "$ref": "#/$defs/nonEmpty" },
        "baseline": { "$ref": "#/$defs/nonEmpty" },
        "enhanced": { "$ref": "#/$defs/nonEmpty" },
        "reason": {
          "enum": ["clarity", "attention", "aesthetics", "immersion", "spatial_robustness"]
        },
        "expected_evidence": { "$ref": "#/$defs/nonEmpty" },
        "essence_preserved": { "const": true }
      }
    },
    "aestheticSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette",
        "background",
        "gradients",
        "depth",
        "connectors",
        "components",
        "typography",
        "protagonist_state",
        "charts_and_timelines",
        "restraint_rules"
      ],
      "properties": {
        "palette": { "$ref": "#/$defs/nonEmptyList" },
        "background": { "$ref": "#/$defs/nonEmpty" },
        "gradients": { "$ref": "#/$defs/nonEmpty" },
        "depth": { "$ref": "#/$defs/nonEmpty" },
        "connectors": { "$ref": "#/$defs/nonEmpty" },
        "components": { "$ref": "#/$defs/nonEmpty" },
        "typography": { "$ref": "#/$defs/nonEmpty" },
        "protagonist_state": { "$ref": "#/$defs/nonEmpty" },
        "charts_and_timelines": { "$ref": "#/$defs/nonEmpty" },
        "restraint_rules": { "$ref": "#/$defs/nonEmptyList" }
      }
    },
    "attentionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "hold_id",
        "primary",
        "secondary",
        "muted",
        "gaze_path",
        "question_answered"
      ],
      "properties": {
        "scene_id": { "$ref": "#/$defs/nonEmpty" },
        "hold_id": { "$ref": "#/$defs/nonEmpty" },
        "primary": { "$ref": "#/$defs/nonEmpty" },
        "secondary": { "$ref": "#/$defs/stringList" },
        "muted": { "$ref": "#/$defs/stringList" },
        "gaze_path": { "$ref": "#/$defs/nonEmptyList" },
        "question_answered": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "viewportConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewport_id",
        "width_px",
        "height_px",
        "safe_inset_px",
        "minimum_gap_px",
        "minimum_text_px",
        "max_primary_count",
        "max_simultaneous_labels"
      ],
      "properties": {
        "viewport_id": { "$ref": "#/$defs/nonEmpty" },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 },
        "safe_inset_px": { "type": "number", "minimum": 0 },
        "minimum_gap_px": { "type": "number", "minimum": 0 },
        "minimum_text_px": { "type": "number", "exclusiveMinimum": 0 },
        "max_primary_count": { "const": 1 },
        "max_simultaneous_labels": { "type": "integer", "minimum": 1 }
      }
    },
    "geometryConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewports", "connector_clearance_px", "allowed_overlaps", "blocking_checks"],
      "properties": {
        "viewports": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/viewportConstraint" }
        },
        "connector_clearance_px": { "type": "number", "minimum": 0 },
        "allowed_overlaps": { "$ref": "#/$defs/stringList" },
        "blocking_checks": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text_text_overlap",
              "text_object_overlap",
              "clipping",
              "overflow",
              "minimum_text",
              "connector_label_collision",
              "persistent_duplicate",
              "empty_state",
              "protagonist_competition",
              "motion_discontinuity"
            ]
          }
        }
      }
    },
    "comparisonUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "original_reference_id", "baseline_hold_id", "enhanced_hold_id", "viewports"],
      "properties": {
        "scene_id": { "$ref": "#/$defs/nonEmpty" },
        "original_reference_id": { "$ref": "#/$defs/nonEmpty" },
        "baseline_hold_id": { "$ref": "#/$defs/nonEmpty" },
        "enhanced_hold_id": { "$ref": "#/$defs/nonEmpty" },
        "viewports": { "$ref": "#/$defs/nonEmptyList" }
      }
    },
    "comparisonPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variants", "units", "judgement_dimensions"],
      "properties": {
        "variants": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["original", "baseline_faithful", "enhanced_immersive"] }
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/comparisonUnit" }
        },
        "judgement_dimensions": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "essential_fidelity",
              "visual_uplift",
              "immersive_uplift",
              "pedagogical_uplift",
              "spatial_robustness"
            ]
          }
        }
      }
    },
    "globalSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_thesis", "composition_grammar", "hierarchy", "text_role"],
      "properties": {
        "concept_thesis": { "$ref": "#/$defs/nonEmpty" },
        "composition_grammar": { "$ref": "#/$defs/nonEmpty" },
        "hierarchy": { "$ref": "#/$defs/nonEmpty" },
        "text_role": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "essence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "conceptual_elements", "numeric_invariants"],
      "properties": {
        "message": { "$ref": "#/$defs/nonEmpty" },
        "conceptual_elements": { "$ref": "#/$defs/nonEmptyList" },
        "numeric_invariants": { "$ref": "#/$defs/nonEmptyList" }
      }
    },
    "opportunities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual", "pedagogical", "immersive", "spatial"],
      "properties": {
        "visual": { "$ref": "#/$defs/nonEmptyList" },
        "pedagogical": { "$ref": "#/$defs/nonEmptyList" },
        "immersive": { "$ref": "#/$defs/nonEmptyList" },
        "spatial": { "$ref": "#/$defs/nonEmptyList" }
      }
    },
    "hold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hold_id", "purpose", "primary", "visible_elements", "absent_elements", "success_criteria"],
      "properties": {
        "hold_id": { "$ref": "#/$defs/nonEmpty" },
        "purpose": { "$ref": "#/$defs/nonEmpty" },
        "primary": { "$ref": "#/$defs/nonEmpty" },
        "visible_elements": { "$ref": "#/$defs/nonEmptyList" },
        "absent_elements": { "$ref": "#/$defs/stringList" },
        "success_criteria": { "$ref": "#/$defs/nonEmptyList" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "layout", "holds", "desktop", "mobile"],
      "properties": {
        "summary": { "$ref": "#/$defs/nonEmpty" },
        "layout": { "$ref": "#/$defs/nonEmpty" },
        "holds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hold" }
        },
        "desktop": { "$ref": "#/$defs/nonEmpty" },
        "mobile": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "goal",
        "takeaway",
        "preserved_essence",
        "improvement_opportunities",
        "overload_risks",
        "variants",
        "spatial_ownership",
        "exclusions"
      ],
      "properties": {
        "scene_id": { "$ref": "#/$defs/nonEmpty" },
        "goal": { "$ref": "#/$defs/nonEmpty" },
        "takeaway": { "$ref": "#/$defs/nonEmpty" },
        "preserved_essence": { "$ref": "#/$defs/essence" },
        "improvement_opportunities": { "$ref": "#/$defs/opportunities" },
        "overload_risks": { "$ref": "#/$defs/nonEmptyList" },
        "variants": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline_faithful", "enhanced_immersive"],
          "properties": {
            "baseline_faithful": { "$ref": "#/$defs/variant" },
            "enhanced_immersive": { "$ref": "#/$defs/variant" }
          }
        },
        "spatial_ownership": { "$ref": "#/$defs/nonEmptyList" },
        "exclusions": { "$ref": "#/$defs/stringList" }
      }
    }
  }
}
