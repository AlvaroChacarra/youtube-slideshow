{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlvaroChacarra/youtube-slideshow/contracts/audit-report.schema.json",
  "x-schema-version": "3.0.0",
  "title": "Comparative Audit Report V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_id",
    "subject_commit",
    "implementation_manifest_hash",
    "consumed_versions",
    "independence",
    "evidence",
    "comparative_assessment",
    "scores",
    "geometry_gate",
    "findings",
    "blockers",
    "limitations",
    "verdict",
    "decision",
    "required_next_owner"
  ],
  "properties": {
    "audit_id": { "$ref": "#/$defs/nonEmpty" },
    "subject_commit": { "$ref": "#/$defs/gitSha" },
    "implementation_manifest_hash": { "$ref": "#/$defs/sha256" },
    "consumed_versions": { "$ref": "#/$defs/consumedVersions" },
    "independence": { "$ref": "#/$defs/independence" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "comparative_assessment": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/comparativeAssessment" }
    },
    "scores": { "$ref": "#/$defs/scores" },
    "geometry_gate": { "$ref": "#/$defs/geometryGate" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "blockers": { "$ref": "#/$defs/stringList" },
    "limitations": { "$ref": "#/$defs/stringList" },
    "verdict": {
      "enum": ["blocked", "revision_required", "ready_for_user_review", "reference_candidate"]
    },
    "decision": { "enum": ["GO_ENHANCED_V3", "NO_GO_ENHANCED_V3"] },
    "required_next_owner": {
      "enum": [
        "visual-director-lienzo",
        "motion-director-lienzo",
        "frontend-producer-lienzo",
        "narrative-owner",
        "user",
        "none"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "verdict": { "const": "blocked" } },
        "required": ["verdict"]
      },
      "then": { "properties": { "blockers": { "minItems": 1 } } }
    },
    {
      "if": {
        "properties": { "decision": { "const": "GO_ENHANCED_V3" } },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "blockers": { "maxItems": 0 },
          "findings": {
            "not": {
              "contains": {
                "properties": { "severity": { "enum": ["blocker", "major"] } },
                "required": ["severity"]
              }
            }
          },
          "geometry_gate": {
            "properties": {
              "status": { "const": "PASS" },
              "material_violation_count": { "const": 0 }
            }
          },
          "comparative_assessment": {
            "items": {
              "properties": {
                "essential_fidelity": { "const": "passed" },
                "visual_uplift": { "const": "material" },
                "immersive_uplift": { "const": "material" },
                "pedagogical_uplift": { "enum": ["improved", "preserved"] },
                "spatial_robustness": { "const": "passed" }
              }
            }
          },
          "evidence": {
            "properties": {
              "mobile": { "properties": { "status": { "const": "passed" } } },
              "reverse": { "properties": { "status": { "const": "passed" } } },
              "reset": { "properties": { "status": { "const": "passed" } } },
              "reduced_motion": { "properties": { "status": { "const": "passed" } } },
              "reproducibility": { "properties": { "status": { "const": "passed" } } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "verdict": { "const": "reference_candidate" } },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "independence": { "properties": { "fully_independent": { "const": true } } },
          "scores": {
            "properties": {
              "pedagogical_comprehension": { "minimum": 9 },
              "composition_and_hierarchy": { "minimum": 9 },
              "visual_craft_and_taste": { "minimum": 9 },
              "total": { "minimum": 9 }
            }
          },
          "required_next_owner": { "const": "none" }
        }
      }
    },
    {
      "if": {
        "properties": { "verdict": { "const": "ready_for_user_review" } },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "scores": {
            "properties": {
              "pedagogical_comprehension": { "minimum": 8 },
              "composition_and_hierarchy": { "minimum": 8 },
              "visual_craft_and_taste": { "minimum": 8 },
              "total": { "minimum": 8 }
            }
          },
          "required_next_owner": { "const": "user" }
        }
      }
    }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "nonEmptyList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "consumedVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_contract",
        "motion_contract",
        "implementation_manifest_schema",
        "audit_report_schema"
      ],
      "properties": {
        "visual_contract": { "const": "3.0.0" },
        "motion_contract": { "const": "3.0.0" },
        "implementation_manifest_schema": { "const": "3.0.0" },
        "audit_report_schema": { "const": "3.0.0" }
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fully_independent",
        "output_observed_before_rationale",
        "auditor_created_subject",
        "auditor_remediated_subject",
        "known_sources_before_first_pass",
        "limitations"
      ],
      "properties": {
        "fully_independent": { "type": "boolean" },
        "output_observed_before_rationale": { "type": "boolean" },
        "auditor_created_subject": { "type": "boolean" },
        "auditor_remediated_subject": { "type": "boolean" },
        "known_sources_before_first_pass": { "type": "boolean" },
        "limitations": { "$ref": "#/$defs/stringList" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["passed", "failed", "limited", "not_tested"] },
        "evidence": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_hash", "kind", "viewport_id"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "content_hash": { "$ref": "#/$defs/sha256" },
        "kind": { "enum": ["still", "interactive_session", "build_log", "test_log", "geometry_report", "comparison", "other"] },
        "viewport_id": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "inspected_holds",
        "inspected_beats",
        "mobile",
        "reverse",
        "reset",
        "reduced_motion",
        "reproducibility"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "inspected_holds": { "$ref": "#/$defs/nonEmptyList" },
        "inspected_beats": { "$ref": "#/$defs/nonEmptyList" },
        "mobile": { "$ref": "#/$defs/result" },
        "reverse": { "$ref": "#/$defs/result" },
        "reset": { "$ref": "#/$defs/result" },
        "reduced_motion": { "$ref": "#/$defs/result" },
        "reproducibility": { "$ref": "#/$defs/result" }
      }
    },
    "comparativeAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "comparison_evidence",
        "essential_fidelity",
        "visual_uplift",
        "immersive_uplift",
        "pedagogical_uplift",
        "spatial_robustness",
        "baseline_summary",
        "enhanced_summary"
      ],
      "properties": {
        "scene_id": { "$ref": "#/$defs/nonEmpty" },
        "comparison_evidence": { "$ref": "#/$defs/artifact" },
        "essential_fidelity": { "enum": ["passed", "failed", "limited"] },
        "visual_uplift": { "enum": ["material", "marginal", "none", "regressed"] },
        "immersive_uplift": { "enum": ["material", "marginal", "none", "regressed"] },
        "pedagogical_uplift": { "enum": ["improved", "preserved", "regressed"] },
        "spatial_robustness": { "enum": ["passed", "failed", "limited"] },
        "baseline_summary": { "$ref": "#/$defs/nonEmpty" },
        "enhanced_summary": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "score": { "type": "number", "minimum": 0, "maximum": 10 },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pedagogical_comprehension",
        "composition_and_hierarchy",
        "visual_craft_and_taste",
        "motion_and_continuity",
        "cognitive_load_and_pacing",
        "interaction_and_holds",
        "mobile_legibility",
        "technical_robustness",
        "total"
      ],
      "properties": {
        "pedagogical_comprehension": { "$ref": "#/$defs/score" },
        "composition_and_hierarchy": { "$ref": "#/$defs/score" },
        "visual_craft_and_taste": { "$ref": "#/$defs/score" },
        "motion_and_continuity": { "$ref": "#/$defs/score" },
        "cognitive_load_and_pacing": { "$ref": "#/$defs/score" },
        "interaction_and_holds": { "$ref": "#/$defs/score" },
        "mobile_legibility": { "$ref": "#/$defs/score" },
        "technical_robustness": { "$ref": "#/$defs/score" },
        "total": { "$ref": "#/$defs/score" }
      }
    },
    "geometryGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "report_path", "report_hash", "states_checked", "material_violation_count", "sampling_verified"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL"] },
        "report_path": { "$ref": "#/$defs/nonEmpty" },
        "report_hash": { "$ref": "#/$defs/sha256" },
        "states_checked": { "type": "integer", "minimum": 1 },
        "material_violation_count": { "type": "integer", "minimum": 0 },
        "sampling_verified": { "type": "boolean" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "scene_id",
        "severity",
        "evidence",
        "consequence",
        "probable_cause",
        "verifiable_correction",
        "owner",
        "failure_origin"
      ],
      "properties": {
        "finding_id": { "$ref": "#/$defs/nonEmpty" },
        "scene_id": { "$ref": "#/$defs/nonEmpty" },
        "severity": { "enum": ["blocker", "major", "minor", "nit"] },
        "evidence": { "$ref": "#/$defs/nonEmpty" },
        "consequence": { "$ref": "#/$defs/nonEmpty" },
        "probable_cause": { "$ref": "#/$defs/nonEmpty" },
        "verifiable_correction": { "$ref": "#/$defs/nonEmpty" },
        "owner": {
          "enum": [
            "visual-director-lienzo",
            "motion-director-lienzo",
            "frontend-producer-lienzo",
            "narrative-owner",
            "user"
          ]
        },
        "failure_origin": { "enum": ["upstream_design", "implementation", "motion", "semantic_spec", "not_applicable"] }
      }
    }
  }
}
