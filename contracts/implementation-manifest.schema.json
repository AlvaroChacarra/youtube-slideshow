{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlvaroChacarra/youtube-slideshow/contracts/implementation-manifest.schema.json",
  "x-schema-version": "3.0.0",
  "title": "Implementation Manifest V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "implementation_id",
    "status",
    "narrative_hash",
    "visual_contract_hash",
    "motion_contract_hash",
    "consumed_versions",
    "subject_commit",
    "stack",
    "commands",
    "variants",
    "outputs",
    "scenes",
    "tests",
    "visual_evidence",
    "reference_context",
    "comparisons",
    "viewports",
    "geometry_gate",
    "deviations",
    "limitations"
  ],
  "properties": {
    "implementation_id": { "$ref": "#/$defs/nonEmpty" },
    "status": { "enum": ["draft", "implemented", "blocked", "superseded"] },
    "narrative_hash": { "$ref": "#/$defs/sha256" },
    "visual_contract_hash": { "$ref": "#/$defs/sha256" },
    "motion_contract_hash": { "$ref": "#/$defs/sha256" },
    "consumed_versions": { "$ref": "#/$defs/consumedVersions" },
    "subject_commit": { "$ref": "#/$defs/gitSha" },
    "stack": { "$ref": "#/$defs/nonEmptyList" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command" }
    },
    "variants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["baseline_faithful", "enhanced_immersive"] }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "scenes": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/scene" }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/test" }
    },
    "visual_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "reference_context": { "$ref": "#/$defs/referenceContext" },
    "comparisons": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/comparison" }
    },
    "viewports": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/viewport" }
    },
    "geometry_gate": { "$ref": "#/$defs/geometryGate" },
    "deviations": {
      "type": "array",
      "items": { "$ref": "#/$defs/deviation" }
    },
    "limitations": { "$ref": "#/$defs/stringList" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "implemented" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "tests": {
            "not": {
              "contains": {
                "properties": { "status": { "enum": ["failed", "not_run"] } },
                "required": ["status"]
              }
            }
          },
          "deviations": {
            "not": {
              "contains": {
                "properties": { "approved": { "const": false } },
                "required": ["approved"]
              }
            }
          },
          "geometry_gate": {
            "properties": {
              "enhanced": {
                "properties": {
                  "status": { "const": "PASS" },
                  "material_violation_count": { "const": 0 }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "nonEmptyList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "consumedVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_contract", "motion_contract", "implementation_manifest_schema"],
      "properties": {
        "visual_contract": { "const": "3.0.0" },
        "motion_contract": { "const": "3.0.0" },
        "implementation_manifest_schema": { "const": "3.0.0" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "purpose"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "command": { "$ref": "#/$defs/nonEmpty" },
        "purpose": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "content_hash"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["application", "asset", "data", "capture", "report", "other"] },
        "content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "variant", "implemented_beats", "holds_verified"],
      "properties": {
        "scene_id": { "$ref": "#/$defs/nonEmpty" },
        "variant": { "enum": ["baseline_faithful", "enhanced_immersive"] },
        "implemented_beats": { "$ref": "#/$defs/nonEmptyList" },
        "holds_verified": { "$ref": "#/$defs/nonEmptyList" }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "status", "evidence"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "command": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["passed", "failed", "not_run", "expected_fail"] },
        "evidence": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "scene_id",
        "variant",
        "hold_id",
        "beat_id",
        "state",
        "viewport_id",
        "path",
        "content_hash"
      ],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/nonEmpty" },
        "scene_id": { "$ref": "#/$defs/nonEmpty" },
        "variant": { "enum": ["original", "baseline_faithful", "enhanced_immersive"] },
        "hold_id": { "type": ["string", "null"] },
        "beat_id": { "type": ["string", "null"] },
        "state": {
          "enum": [
            "original",
            "hold",
            "beat_start",
            "max_change",
            "beat_end",
            "reverse",
            "reset",
            "reduced_motion",
            "mobile_presenter",
            "mobile_downsample",
            "comparison",
            "geometry_annotation"
          ]
        },
        "viewport_id": { "$ref": "#/$defs/nonEmpty" },
        "path": { "$ref": "#/$defs/nonEmpty" },
        "content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "referenceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "reference_ids", "fullscreen_reference_used", "runtime_reference_requests"],
      "properties": {
        "applicable": { "const": true },
        "reference_ids": { "$ref": "#/$defs/nonEmptyList" },
        "fullscreen_reference_used": { "const": false },
        "runtime_reference_requests": { "const": 0 }
      }
    },
    "evidencePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_hash", "viewport_id"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "content_hash": { "$ref": "#/$defs/sha256" },
        "viewport_id": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "reference_id",
        "original",
        "baseline",
        "enhanced",
        "comparison_surface",
        "baseline_fidelity",
        "enhancement_delta_traced"
      ],
      "properties": {
        "scene_id": { "$ref": "#/$defs/nonEmpty" },
        "reference_id": { "$ref": "#/$defs/nonEmpty" },
        "original": { "$ref": "#/$defs/evidencePointer" },
        "baseline": { "$ref": "#/$defs/evidencePointer" },
        "enhanced": { "$ref": "#/$defs/evidencePointer" },
        "comparison_surface": { "$ref": "#/$defs/evidencePointer" },
        "baseline_fidelity": { "enum": ["passed", "limited", "failed"] },
        "enhancement_delta_traced": { "const": true }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewport_id", "browser", "width_px", "height_px", "device_pixel_ratio", "purpose", "minimum_text_px"],
      "properties": {
        "viewport_id": { "$ref": "#/$defs/nonEmpty" },
        "browser": { "$ref": "#/$defs/nonEmpty" },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 },
        "device_pixel_ratio": { "type": "number", "exclusiveMinimum": 0 },
        "purpose": { "$ref": "#/$defs/nonEmpty" },
        "minimum_text_px": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "geometryViolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "scene_id", "hold_or_beat_id", "viewport_id", "ids", "measurement", "threshold", "owner", "annotated_screenshot"],
      "properties": {
        "code": { "$ref": "#/$defs/nonEmpty" },
        "scene_id": { "$ref": "#/$defs/nonEmpty" },
        "hold_or_beat_id": { "$ref": "#/$defs/nonEmpty" },
        "viewport_id": { "$ref": "#/$defs/nonEmpty" },
        "ids": { "$ref": "#/$defs/nonEmptyList" },
        "measurement": { "$ref": "#/$defs/nonEmpty" },
        "threshold": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "enum": ["visual-director-lienzo", "motion-director-lienzo", "frontend-producer-lienzo"] },
        "annotated_screenshot": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "geometryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "report",
        "content_hash",
        "viewports_covered",
        "states_checked",
        "material_violation_count",
        "violations",
        "annotated_screenshots"
      ],
      "properties": {
        "status": { "enum": ["PASS", "FAIL"] },
        "report": { "$ref": "#/$defs/nonEmpty" },
        "content_hash": { "$ref": "#/$defs/sha256" },
        "viewports_covered": { "$ref": "#/$defs/nonEmptyList" },
        "states_checked": { "type": "integer", "minimum": 1 },
        "material_violation_count": { "type": "integer", "minimum": 0 },
        "violations": {
          "type": "array",
          "items": { "$ref": "#/$defs/geometryViolation" }
        },
        "annotated_screenshots": { "$ref": "#/$defs/nonEmptyList" }
      }
    },
    "geometryGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "enhanced"],
      "properties": {
        "baseline": { "$ref": "#/$defs/geometryResult" },
        "enhanced": { "$ref": "#/$defs/geometryResult" }
      }
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviation_id", "contract", "description", "impact", "approved", "approval_reference"],
      "properties": {
        "deviation_id": { "$ref": "#/$defs/nonEmpty" },
        "contract": { "enum": ["visual", "motion", "narrative", "audit_criteria"] },
        "description": { "$ref": "#/$defs/nonEmpty" },
        "impact": { "$ref": "#/$defs/nonEmpty" },
        "approved": { "type": "boolean" },
        "approval_reference": { "type": ["string", "null"] }
      }
    }
  }
}
