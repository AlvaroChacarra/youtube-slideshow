{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlvaroChacarra/youtube-slideshow/contracts/implementation-manifest.schema.json",
  "x-schema-version": "2.1.0",
  "title": "Implementation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "implementation_id",
    "status",
    "narrative_hash",
    "visual_contract_hash",
    "motion_contract_hash",
    "consumed_versions",
    "commit",
    "stack",
    "commands",
    "outputs",
    "scenes",
    "tests",
    "visual_evidence",
    "viewports",
    "deviations",
    "limitations"
  ],
  "properties": {
    "implementation_id": { "$ref": "#/$defs/nonEmpty" },
    "status": { "enum": ["draft", "implemented", "blocked", "superseded"] },
    "narrative_hash": { "$ref": "#/$defs/sha256" },
    "visual_contract_hash": { "$ref": "#/$defs/sha256" },
    "motion_contract_hash": { "$ref": "#/$defs/sha256" },
    "consumed_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_contract", "motion_contract", "implementation_manifest_schema"],
      "properties": {
        "visual_contract": { "$ref": "#/$defs/version" },
        "motion_contract": { "$ref": "#/$defs/version" },
        "implementation_manifest_schema": { "$ref": "#/$defs/version" }
      }
    },
    "commit": { "$ref": "#/$defs/gitSha" },
    "stack": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
    "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/command" } },
    "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/output" } },
    "scenes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scene" } },
    "tests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/test" } },
    "visual_evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
    "reference_context": { "$ref": "#/$defs/referenceContext" },
    "reference_comparisons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/referenceComparison" }
    },
    "viewports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/viewport" } },
    "deviations": { "type": "array", "items": { "$ref": "#/$defs/deviation" } },
    "limitations": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }
  },
  "dependentSchemas": {
    "reference_comparisons": { "required": ["reference_context"] }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "consumed_versions": {
            "properties": { "implementation_manifest_schema": { "const": "2.1.0" } },
            "required": ["implementation_manifest_schema"]
          }
        },
        "required": ["consumed_versions"]
      },
      "then": {
        "required": ["reference_context"],
        "properties": {
          "reference_comparisons": {
            "items": { "required": ["scene_id"] }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "implemented" } }, "required": ["status"] },
      "then": {
        "properties": {
          "tests": {
            "not": {
              "contains": {
                "type": "object",
                "properties": { "status": { "enum": ["failed", "not_run"] } },
                "required": ["status"]
              }
            }
          },
          "deviations": {
            "not": {
              "contains": {
                "type": "object",
                "properties": { "approved": { "const": false } },
                "required": ["approved"]
              }
            }
          },
          "reference_comparisons": {
            "allOf": [
              {
                "not": {
                  "contains": {
                    "type": "object",
                    "properties": { "status": { "enum": ["failed", "not_tested"] } },
                    "required": ["status"]
                  }
                }
              },
              {
                "not": {
                  "contains": {
                    "type": "object",
                    "properties": { "pixel_diff_only": { "const": true } },
                    "required": ["pixel_diff_only"]
                  }
                }
              },
              {
                "not": {
                  "contains": {
                    "type": "object",
                    "properties": { "fullscreen_reference_used": { "const": true } },
                    "required": ["fullscreen_reference_used"]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reference_context": {
            "properties": { "applicable": { "const": true } },
            "required": ["applicable"]
          }
        },
        "required": ["reference_context"]
      },
      "then": {
        "required": ["reference_comparisons"],
        "properties": { "reference_comparisons": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": {
          "reference_context": {
            "properties": { "applicable": { "const": false } },
            "required": ["applicable"]
          }
        },
        "required": ["reference_context"]
      },
      "then": {
        "properties": { "reference_comparisons": { "maxItems": 0 } }
      }
    }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "referenceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "reference_ids"],
      "properties": {
        "applicable": { "type": "boolean" },
        "reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "applicable": { "const": true } }, "required": ["applicable"] },
          "then": { "properties": { "reference_ids": { "minItems": 1 } } },
          "else": { "properties": { "reference_ids": { "maxItems": 0 } } }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "purpose"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "command": { "$ref": "#/$defs/nonEmpty" },
        "purpose": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "content_hash"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["application", "asset", "data", "capture", "report", "other"] },
        "content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "implemented_beats", "holds_verified"],
      "properties": {
        "scene_id": { "$ref": "#/$defs/nonEmpty" },
        "implemented_beats": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
        "holds_verified": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "status", "evidence"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "command": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["passed", "failed", "not_run"] },
        "evidence": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "scene_id", "beat_id", "state", "viewport_id", "path", "content_hash"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/nonEmpty" },
        "scene_id": { "$ref": "#/$defs/nonEmpty" },
        "beat_id": { "type": ["string", "null"] },
        "state": { "enum": ["hold", "beat_start", "max_change", "beat_end", "reverse", "reset", "reduced_motion", "mobile_downsample"] },
        "viewport_id": { "$ref": "#/$defs/nonEmpty" },
        "path": { "$ref": "#/$defs/nonEmpty" },
        "content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "referenceDifference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "difference_id",
        "property",
        "description",
        "material",
        "deliberate",
        "approval_reference"
      ],
      "properties": {
        "difference_id": { "$ref": "#/$defs/nonEmpty" },
        "property": { "$ref": "#/$defs/nonEmpty" },
        "description": { "$ref": "#/$defs/nonEmpty" },
        "material": { "type": "boolean" },
        "deliberate": { "type": "boolean" },
        "approval_reference": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "material": { "const": true } }, "required": ["material"] },
          "then": {
            "properties": {
              "deliberate": { "const": true },
              "approval_reference": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        }
      ]
    },
    "referenceComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "reference_hash",
        "screenshot_hash",
        "viewport_id",
        "hold_id",
        "status",
        "comparison_methods",
        "pixel_diff_only",
        "fullscreen_reference_used",
        "reconstruction_evidence",
        "material_differences"
      ],
      "properties": {
        "reference_id": { "$ref": "#/$defs/nonEmpty" },
        "reference_hash": { "$ref": "#/$defs/sha256" },
        "screenshot_hash": { "$ref": "#/$defs/sha256" },
        "scene_id": {
          "$ref": "#/$defs/nonEmpty",
          "description": "Scene from the visual reference binding; required for 2.1 manifests."
        },
        "viewport_id": { "$ref": "#/$defs/nonEmpty" },
        "hold_id": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["passed", "failed", "limited", "not_tested"] },
        "comparison_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "screenshot_diff",
              "bounding_boxes",
              "dom_geometry",
              "perceptual_comparison",
              "computer_vision",
              "human_or_agent_inspection"
            ]
          }
        },
        "pixel_diff_only": { "type": "boolean" },
        "fullscreen_reference_used": { "type": "boolean" },
        "reconstruction_evidence": {
          "type": "array",
          "minItems": 1,
          "description": "Evidencia positiva o negativa de la reconstrucción observada; en failed debe documentar la causa visible.",
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "material_differences": {
          "type": "array",
          "items": { "$ref": "#/$defs/referenceDifference" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "fullscreen_reference_used": { "const": true } },
            "required": ["fullscreen_reference_used"]
          },
          "then": { "properties": { "status": { "const": "failed" } } }
        },
        {
          "if": {
            "properties": { "pixel_diff_only": { "const": true } },
            "required": ["pixel_diff_only"]
          },
          "then": {
            "properties": {
              "status": { "enum": ["failed", "limited"] },
              "comparison_methods": {
                "minItems": 1,
                "maxItems": 1,
                "contains": { "const": "screenshot_diff" }
              }
            }
          },
          "else": {
            "properties": {
              "comparison_methods": {
                "contains": {
                  "enum": [
                    "bounding_boxes",
                    "dom_geometry",
                    "perceptual_comparison",
                    "computer_vision",
                    "human_or_agent_inspection"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewport_id", "browser", "width_px", "height_px", "device_pixel_ratio", "purpose"],
      "properties": {
        "viewport_id": { "$ref": "#/$defs/nonEmpty" },
        "browser": { "$ref": "#/$defs/nonEmpty" },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 },
        "device_pixel_ratio": { "type": "number", "exclusiveMinimum": 0 },
        "purpose": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviation_id", "contract", "description", "reason", "impact", "approved", "approval_reference"],
      "properties": {
        "deviation_id": { "$ref": "#/$defs/nonEmpty" },
        "contract": { "enum": ["visual", "motion", "narrative", "audit_criteria"] },
        "description": { "$ref": "#/$defs/nonEmpty" },
        "reason": { "$ref": "#/$defs/nonEmpty" },
        "impact": { "$ref": "#/$defs/nonEmpty" },
        "approved": { "type": "boolean" },
        "approval_reference": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "approved": { "const": true } }, "required": ["approved"] },
          "then": { "properties": { "approval_reference": { "$ref": "#/$defs/nonEmpty" } } }
        }
      ]
    }
  }
}
